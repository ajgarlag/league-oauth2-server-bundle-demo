{% extends 'base.html.twig' %}

{% block title %}OAuth2 Device Authorization Decision Result{% endblock %}

{% block main %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h1 class="card-title mb-0 display-6">🆔 Device Authorization Decision Result</h1>
                </div>
                <div class="card-body p-5">
                    <div class="mb-4">
                        {% if deviceCode.userApproved %}
                            <div class="alert alert-success" role="alert">
                                <strong>✅ Access Granted:</strong> You have successfully authorized the device to access your account. You should return to the device to continue the process.
                            </div>
                        {% else %}
                            <div class="alert alert-danger" role="alert">
                                <strong>❌ Access Denied:</strong> You have denied the device access to your account.
                            </div>
                        {% endif %}

                        <h2 class="card-subtitle mb-3">Client Information</h2>

                        <div class="row mb-3">
                            <div class="col-sm-4">
                                <strong>Client ID:</strong>
                            </div>
                            <div class="col-sm-8">
                                <code>{{ deviceCode.client.identifier }}</code>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-4">
                                <strong>Client Name:</strong>
                            </div>
                            <div class="col-sm-8">
                                {{ deviceCode.client.name }}
                            </div>
                        </div>
                    </div>

                    {% if deviceCode.scopes|length > 0 %}
                        <div class="mb-4">
                            <h5>Requested Permissions:</h5>
                            <div class="list-group">
                                {% for scope in deviceCode.scopes %}
                                    <div class="list-group-item">
                                        <small class="badge bg-info">{{ scope }}</small>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
