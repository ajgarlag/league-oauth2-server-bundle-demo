{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block main %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="avatar-circle mx-auto" style="width: 100px; height: 100px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem;">
                            👤
                        </div>
                    </div>

                    <h1 class="card-title mb-2">User Profile</h1>
                    <h2 class="card-subtitle text-muted mb-4">👋 Hello, <strong>{{ app.user }}</strong>!</h2>

                    <div class="alert alert-info" role="alert">
                        <strong>Status:</strong> Session authenticated successfully
                    </div>

                    <div class="d-grid gap-2">
                        <a href="{{ logout_path() }}" data-turbo-prefetch="false" class="btn btn-outline-danger btn-lg">
                            🚪 Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
