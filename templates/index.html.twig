{% extends 'base.html.twig' %}

{% block title %}league/oauth2-server-bundle demo{% endblock %}

{% block main %}
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-body p-5">
                    <h1 class="card-title mb-4 text-center">Welcome to OAuth2 Server Bundle Demo</h1>

                    <p class="lead text-muted mb-4">
                        This is a demonstration of the <strong>league/oauth2-server-bundle</strong>, a Symfony integration
                        that implements the OAuth 2.0 authorization server specification.
                    </p>

                    {% if not app.user %}
                        <hr class="my-4">

                        <div class="text-center">
                            <p class="text-muted small mb-3">Ready to get started?</p>
                            <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">
                                🔐 Login Now
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="card shadow-lg border-0">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">🔌 OAuth2 Client Tester</h5>
                </div>
                <div class="card-body p-5">
                    <p class="mb-3">
                        Test the OAuth2 server implementation with different authentication flows and grant types.
                    </p>
                    <p class="text-muted small mb-4">
                        Opens in a new window for independent testing.
                    </p>
                    <div class="text-center">
                        <a href="{{ path('app_client') }}" class="btn btn-info btn-lg" target="_blank">
                            🔌 Open OAuth2 Client Tester
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
