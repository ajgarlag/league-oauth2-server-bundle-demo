<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>OAuth2 Client Test</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
        {{ importmap('client') }}
    </head>
    <body class="bg-light" {{ stimulus_controller('client') }}>
        <header class="bg-dark text-white py-4 mb-4">
            <div class="container">
                <h1 class="mb-0 display-6">OAuth2 Client Test</h1>
            </div>
        </header>

        <main class="container mb-5">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Setup Instructions -->
                    <div class="card shadow-lg border-0 mb-4">
                        <div class="card-header bg-info text-white">
                            <h2 class="card-title mb-0">📋 Setup Instructions</h2>
                        </div>
                        <div class="card-body">
                            <h5 class="mb-3">Create OAuth2 Client</h5>
                            <p>Before testing, you need to create an OAuth2 client using the following command:</p>
                            <pre class="bg-dark text-light p-3 rounded"><code>bin/console league:oauth2-server:create-client "Test Client" \
    --redirect-uri={{ url('app_client') }} \
    --grant-type=authorization_code \
    --grant-type=implicit \
    --grant-type=password \
    --grant-type=client_credentials \
    --grant-type=refresh_token \
    --scope=email \
    --scope=profile</code></pre>
                            <p class="mb-2"><strong>This will output:</strong></p>
                            <ul>
                                <li><strong>Client ID:</strong> Copy this to the "Client ID" field below</li>
                                <li><strong>Client Secret:</strong> Copy this to the "Client Secret" field below</li>
                            </ul>
                            <p class="text-muted small"><strong>Note:</strong> The client credentials are automatically saved and restored in your browser's sessionStorage (per-tab storage). The <code>--grant-type=refresh_token</code> is required to enable token refreshing.</p>
                        </div>
                    </div>

                    <!-- Configuration -->
                    <div class="card shadow-lg border-0 mb-4">
                        <div class="card-header bg-dark text-white">
                            <h3 class="card-title mb-0">⚙️ Configuration</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="clientId" class="form-label">Client ID:</label>
                                    <input id="clientId" type="text" class="form-control form-control-lg" required {{ stimulus_target('client', 'clientId') }}>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="clientSecret" class="form-label">Client Secret:</label>
                                    <input id="clientSecret" type="password" class="form-control form-control-lg" required {{ stimulus_target('client', 'clientSecret') }}>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="scopes" class="form-label">Scopes:</label>
                                <select id="scopes" class="form-select form-select-lg" multiple {{ stimulus_target('client', 'scopes') }}>
                                    <option value="email" selected>email</option>
                                    <option value="profile">profile</option>
                                </select>
                                <small class="form-text text-muted">Hold Ctrl/Cmd to select multiple scopes</small>
                            </div>
                        </div>
                    </div>

                    <!-- Authorization Flows -->
                    <div class="card shadow-lg border-0 mb-4">
                        <div class="card-header bg-dark text-white">
                            <h3 class="card-title mb-0">🔐 Authorization Flows</h3>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2 d-md-flex flex-wrap">
                                <button type="button" class="btn btn-primary" data-turbo="false" {{ stimulus_action('client', 'authorizeCode', 'click') }}>🔐 Authorize (Code)</button>
                                <button type="button" class="btn btn-primary" data-turbo="false" {{ stimulus_action('client', 'authorizeCodePkce', 'click') }}>🔒 Authorize (Code + PKCE)</button>
                                <button type="button" class="btn btn-primary" data-turbo="false" {{ stimulus_action('client', 'authorizeImplicit', 'click') }}>🔓 Authorize (Implicit)</button>
                                <button type="button" class="btn btn-primary" data-turbo="false" {{ stimulus_action('client', 'authorizeClientCredentials', 'click') }}>🤖 Client Credentials</button>
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#passwordDialog">🔑 Password Credentials</button>
                            </div>
                            <div class="mt-3" {{ stimulus_target('client', 'result') }}></div>
                        </div>
                    </div>

                    <!-- Current Token -->
                    <div class="card shadow-lg border-0 mb-4">
                        <div class="card-header bg-dark text-white">
                            <h3 class="card-title mb-0">🎫 Current Token</h3>
                        </div>
                        <div class="card-body">
                            <div class="mb-3" {{ stimulus_target('client', 'tokenInfo') }}></div>

                            <div class="d-grid gap-2 d-md-flex flex-wrap">
                                <button type="button" class="btn btn-outline-primary" disabled {{ stimulus_action('client', 'testEmailApi', 'click') }} {{ stimulus_target('client', 'testEmailApiButton') }}>📧 Test /api/email</button>
                                <button type="button" class="btn btn-outline-primary" disabled {{ stimulus_action('client', 'testProfileApi', 'click') }} {{ stimulus_target('client', 'testProfileApiButton') }}>👤 Test /api/profile</button>
                                <button type="button" class="btn btn-outline-primary" disabled {{ stimulus_action('client', 'testClientApi', 'click') }} {{ stimulus_target('client', 'testClientApiButton') }}>🔧 Test /api/client</button>
                                <button type="button" class="btn btn-outline-primary" disabled {{ stimulus_action('client', 'testAdminApi', 'click') }} {{ stimulus_target('client', 'testAdminApiButton') }}>🔐 Test /api/admin</button>
                                <button type="button" class="btn btn-outline-success" disabled {{ stimulus_action('client', 'refreshToken', 'click') }} {{ stimulus_target('client', 'refreshButton') }}>🔄 Refresh Token</button>
                                <button type="button" class="btn btn-outline-warning" disabled {{ stimulus_action('client', 'resetToken', 'click') }} {{ stimulus_target('client', 'resetButton') }}>🔄 Reset Token</button>
                            </div>
                        </div>
                    </div>

                    <!-- API Result -->
                    <div class="card shadow-lg border-0 mb-4">
                        <div class="card-header bg-dark text-white">
                            <h3 class="card-title mb-0">📊 API Test Result</h3>
                        </div>
                        <div class="card-body">
                            <div {{ stimulus_target('client', 'apiResult') }}></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Password Credentials Modal -->
        <div class="modal fade" id="passwordDialog" tabindex="-1" aria-labelledby="passwordDialogLabel" aria-hidden="true" {{ stimulus_target('client', 'passwordDialog') }}>
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title" id="passwordDialogLabel">🔑 Password Credentials</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form {{ stimulus_target('client', 'passwordForm') }}>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="dialogUsername" class="form-label">Username:</label>
                                <input id="dialogUsername" list="in-memory-users" type="email" class="form-control" {{ stimulus_target('client', 'dialogUsername') }}>
                                <datalist id="in-memory-users">
                                    <option>admin@example.com</option>
                                    <option>user1@example.com</option>
                                    <option>user2@example.com</option>
                                </datalist>
                            </div>
                            <div class="mb-3">
                                <label for="dialogPassword" class="form-label">Password:</label>
                                <input id="dialogPassword" type="password" class="form-control" value="foobar" {{ stimulus_target('client', 'dialogPassword') }}>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary" name="action" value="login">✅ Login</button>
                            <button type="button" class="btn btn-secondary" name="action" value="cancel" data-bs-dismiss="modal">❌ Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <footer class="bg-dark text-white text-center py-4 mt-5">
            <div class="container">
                <p class="mb-0">OAuth2 Client Test Application</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
